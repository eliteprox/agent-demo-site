# PymtHouse (OIDC issuer + M2M for Builder API) — same integration ComfyPeer uses.
PYMTHOUSE_ISSUER_URL=https://staging.pymthouse.com/api/v1/oidc
PYMTHOUSE_PUBLIC_CLIENT_ID=
PYMTHOUSE_M2M_CLIENT_ID=
PYMTHOUSE_M2M_CLIENT_SECRET=
# PYMTHOUSE_ALLOW_INSECURE_HTTP=0

# Auth0 (login). Create a Regular Web Application in Auth0, enable the Google
# social connection, and set the callback URL to {AUTH0_BASE_URL}/auth/callback.
AUTH0_SECRET=
AUTH0_BASE_URL=http://localhost:3000
AUTH0_ISSUER_BASE_URL=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Public site URL (Stripe return URLs, Auth0 callback base)
NEXT_PUBLIC_APP_URL=http://localhost:3000
